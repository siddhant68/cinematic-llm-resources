diff --git a/comfy/model_management.py b/comfy/model_management.py
index ff963eb..ee591e3 100644
--- a/comfy/model_management.py
+++ b/comfy/model_management.py
@@ -1998,6 +1998,18 @@ def supports_mxfp8_compute(device=None):
 
     return True
 
+def supports_int8_compute(device=None):
+    # torch._int_mm has no Metal kernel. On MPS it silently falls back to the CPU
+    # (via PYTORCH_ENABLE_MPS_FALLBACK), which round-trips every quantized linear
+    # off the GPU and is far slower than dequantizing to bf16 and doing the matmul
+    # on-device. Report int8 matmul as unsupported so the mixed-precision ops fall
+    # back to the emulated (dequantize + full-precision) path, which stays on MPS.
+    # Weights remain stored as int8, so the memory saving is preserved.
+    if is_device_mps(device) or mps_mode():
+        return False
+
+    return True
+
 def supports_fp64(device=None):
     if is_device_mps(device):
         return False
